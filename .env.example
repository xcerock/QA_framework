# Copia este archivo a .env y pon tu llave real.
# .env está en .gitignore y nunca debe subirse al repositorio.

ANTHROPIC_API_KEY=sk-ant-...

# Modelo por defecto y lista que aparece en el selector de la interfaz
DEFAULT_MODEL=claude-sonnet-5
AVAILABLE_MODELS=claude-sonnet-5,claude-opus-5,claude-haiku-4-5-20251001

# Cuántos tokens está dispuesto a gastar el modelo: low, medium, high, xhigh.
# Va en output_config.effort. Es el control moderno de esfuerzo.
DEFAULT_EFFORT=medium

# OJO: los modelos Sonnet 5 y Opus 5 rechazan temperature con un 400.
# Gestionan el muestreo por su cuenta. Este valor solo se envía a modelos
# que todavía lo aceptan, como la familia Haiku 4.5.
DEFAULT_TEMPERATURE=1.0

DEFAULT_MAX_TOKENS=400

# Tope de ejecuciones de la demo 2 y llamadas simultáneas
MAX_RUNS=20
CONCURRENCY=6
REQUEST_TIMEOUT=60

# Ponlo en true el día del evento si la red falla.
# Sirve las respuestas guardadas en data/ sin llamar a la API.
REPLAY_MODE=false
DATA_DIR=data

HOST=127.0.0.1
PORT=8000
